# Copy to .env and replace every "change-me" value. .env is git-ignored.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
# Local development runs over plain HTTP; production must keep secure cookies.
DJANGO_SECURE_COOKIES=false

POSTGRES_DB=flowops
POSTGRES_USER=flowops
POSTGRES_PASSWORD=change-me-local-db-password

# Password for every demo user created by `make demo` (min 12 chars).
DEMO_PASSWORD=change-me-demo-password

LOGIN_THROTTLE_RATE=5/min
LOGIN_IP_THROTTLE_RATE=30/min
# Invitation preview/accept per client, comments per user, and per-user limits on sending
# invitations and creating organizations (each invitation sends an email).
INVITATION_THROTTLE_RATE=30/min
COMMENT_THROTTLE_RATE=30/min
INVITATION_CREATE_THROTTLE_RATE=30/hour
ORGANIZATION_CREATE_THROTTLE_RATE=5/hour
# Trusted reverse proxies in front of the API (nginx in docker-compose = 1).
NUM_PROXIES=1
LOG_LEVEL=INFO
# The local demo prints emails (including invitation links) to the API log. Production settings
# require an explicit backend, e.g. django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
